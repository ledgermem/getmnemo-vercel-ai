{
  "name": "@ledgermem/vercel-ai",
  "version": "0.1.0",
  "description": "LedgerMem adapter for the Vercel AI SDK — drop-in tools for streamText / generateText / useChat.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": ["ledgermem", "vercel-ai", "ai-sdk", "memory", "rag", "tools"],
  "author": "LedgerMem <founders@proofly.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ledgermem/ledgermem-vercel-ai.git"
  },
  "dependencies": {
    "@ledgermem/memory": "^0.1.0",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "ai": "^4.0.0",
    "@ai-sdk/react": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/react": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ai": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
